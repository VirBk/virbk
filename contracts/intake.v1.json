{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.grok/contracts/intake.v1.json",
  "title": "Intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "child",
    "at",
    "kind",
    "title",
    "charged",
    "rule",
    "check",
    "portable"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "child": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "trap",
        "lesson",
        "practice"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "charged": {
      "type": "string",
      "minLength": 12
    },
    "rule": {
      "type": "string",
      "minLength": 12
    },
    "check": {
      "type": "string",
      "minLength": 12
    },
    "portable": {
      "type": "string",
      "enum": [
        "portable",
        "machine",
        "reject"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "absorbed",
        "pending",
        "shelved",
        "rejected"
      ]
    },
    "absorbedAs": {
      "type": "string",
      "minLength": 2,
      "description": "The law this became: a trap id (T##) or a file and section (AGENTS.md 5). Required once status is absorbed and portable."
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.grok/contracts/seat-return.v1.json",
  "title": "SeatReturn",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "spendUsd"
      ]
    },
    {
      "required": [
        "tokens"
      ]
    }
  ],
  "required": [
    "lane",
    "runtime",
    "model",
    "base",
    "branch",
    "changed",
    "verify",
    "measured"
  ],
  "properties": {
    "lane": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "string",
      "enum": [
        "local-hands",
        "cloud-grok",
        "desktop-two-process",
        "desktop-qwen",
        "public-fork",
        "team-shared",
        "cloud-git-bus",
        "pc-token",
        "pc-dashscope",
        "cloud-dashscope",
        "help-fork",
        "help-collab"
      ],
      "description": "A topology id from factory/runtimes.json. The catalog is the source; this list is checked against it by factory/tools/seatReturn.mjs."
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "minLength": 7
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verify": {
      "type": "string",
      "minLength": 1
    },
    "spendUsd": {
      "type": "number",
      "minimum": 0,
      "description": "Dollars from the meter. Required unless tokens.source names the meter the numbers were pasted from: the usage record carries no cost, so a zero here would be a durable false measurement."
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in",
        "out",
        "cached",
        "requests",
        "source"
      ],
      "description": "Token counts pasted from the meter: node factory/tools/seatReturn.mjs meter <project-path>.",
      "properties": {
        "in": {
          "type": "number",
          "minimum": 0
        },
        "out": {
          "type": "number",
          "minimum": 0
        },
        "cached": {
          "type": "number",
          "minimum": 0
        },
        "requests": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "The meter the numbers were pasted from, e.g. qwen usage_record.jsonl."
        }
      }
    },
    "note": {
      "type": "string"
    },
    "measured": {
      "type": "string",
      "minLength": 1,
      "description": "What the verify command printed. A word is not output."
    },
    "cachedTokens": {
      "type": "number",
      "minimum": 0,
      "description": "prompt_cache_hit_tokens or cached_tokens, pasted from the meter."
    }
  }
}

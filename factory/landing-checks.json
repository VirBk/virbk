{
  "name": "landing",
  "note": "Steps are parsed from this file as it exists in the commit under test. The gate does not fall back to the working tree. A green gate is evidence about these steps only.",
  "steps": [
    {
      "name": "Size budgets",
      "run": "node factory/tools/sizeBudget.mjs"
    },
    {
      "name": "Board is generated",
      "run": "node factory/tools/renderBoard.mjs --check"
    },
    {
      "name": "Intakes pass the gate",
      "run": "node factory/tools/intake.mjs --check-register"
    },
    {
      "name": "PM picks match the catalog",
      "run": "node factory/tools/hands.mjs --self-test"
    },
    {
      "name": "Scope search names every container",
      "run": "node factory/tools/scopeSearch.mjs --self-test"
    },
    {
      "name": "Owner-ask list is closed",
      "run": "node factory/tools/ownerAsk.mjs --self-test"
    },
    {
      "name": "Sparks TTL and waivers untracked",
      "run": "node factory/tools/spark.mjs --self-test"
    },
    {
      "name": "Writer path clock and failover",
      "run": "node factory/tools/route.mjs --self-test"
    },
    {
      "name": "Seat launch: packet on stdin, key from the store, holds, census",
      "run": "node factory/tools/seat.mjs --self-test"
    },
    {
      "name": "Sitting is one class of work",
      "run": "node factory/tools/sitting.mjs --self-test"
    },
    {
      "name": "Live sitting class",
      "run": "node factory/tools/sitting.mjs check"
    },
    {
      "name": "Public landing Action stays green",
      "run": "test -f .github/workflows/landing.yml && grep -q 'landingGate.mjs' .github/workflows/landing.yml && ! grep -E 'DASHSCOPE_API_KEY|DEEPSEEK_API_KEY' .github/workflows/landing.yml"
    },
    {
      "name": "Writer Action idles; never pushes main",
      "run": "node factory/tools/ghaWriter.mjs --self-test"
    },
    {
      "name": "Kit holds its own shape",
      "run": "node factory/tools/kitCheck.mjs --self-test"
    },
    {
      "name": "Gate unpacks on this platform",
      "run": "node factory/tools/landingGate.mjs --self-test"
    },
    {
      "name": "Reading path shape",
      "run": "node factory/tools/packet.mjs --self-test"
    },
    {
      "name": "Reading path under its context budget",
      "run": "node factory/tools/packet.mjs --check"
    },
    {
      "name": "Ledger is a window, not a novel",
      "run": "node factory/tools/ledger.mjs --self-test"
    },
    {
      "name": "Alumni scan is read-only and emits valid intakes",
      "run": "node factory/tools/alumni.mjs --self-test"
    },
    {
      "name": "A return pastes the command",
      "run": "node factory/tools/seatReturn.mjs --self-test"
    },
    {
      "name": "Experiments expire and are honest",
      "run": "node factory/tools/experiment.mjs --self-test && node factory/tools/experiment.mjs check"
    }
  ]
}
